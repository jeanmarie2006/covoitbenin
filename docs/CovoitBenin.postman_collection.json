              "mode": "raw",
              "raw": "{\n  \"name\": \"Awa Test\",\n  \"email\": \"awa@exemple.bj\",\n  \"password\": \"motdepasse\",\n  \"role\": \"passager\",\n  \"telephone\": \"+229 01 96 00 00 00\"\n}"
