                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Enregistre automatiquement le jeton dans la variable {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"conducteur@covoitbenin.bj\",\n  \"password\": \"demo1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set(\"token\", d.token); }"
                ]
              }
            }
          ]
        },
